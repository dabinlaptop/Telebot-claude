BOT_TOKEN=توکن_ربات_از_بات‌فادر_اینجا
DB_PATH=bot_database.db

# شناسه‌ی عددی تلگرام ادمین(ها) - با کاما جدا کن، بدون فاصله
# برای گرفتن شناسه‌ی عددی خودت: به ربات @userinfobot پیام بده
ADMIN_IDS=

# پنل وب مدیریت تنظیمات (بدون نیاز به سرور/ری‌دیپلوی)
# ⚠️ اگه WEB_PANEL_PASSWORD رو خالی بذاری، پنل کلاً غیرفعال می‌مونه (امن‌تره)
# حتماً یه رمز قوی و غیرقابل‌حدس بذار چون این پنل می‌تونه کاربر مسدود/رفع‌مسدود کنه
WEB_PANEL_USERNAME=admin
WEB_PANEL_PASSWORD=
WEB_PANEL_ENABLED=true
# PORT رو خود Railway خودکار ست می‌کنه؛ برای اجرای لوکال نیازی به تنظیمش نیست (پیش‌فرض 8000)
